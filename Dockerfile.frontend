# =========================================================================
# DOCKERFILE - FRONTEND CLIENT (REACT 19 + VITE + NGINX)
# Project: Case Management Hearing e-Portal (Order XV-A CPC)
# SVVV B.Tech CSE Semester-VII Major Project (BTCS706N) - Team MP-14
# =========================================================================

# -------------------------------------------------------------------------
# STAGE 1: COMPILE PRODUCTION REACT ASSETS (NODE 20)
# -------------------------------------------------------------------------
FROM node:20-alpine AS builder

WORKDIR /app

# Install dependencies with clean cache
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm install

# Copy frontend source files
COPY frontend/ ./

# Compile production bundle
RUN npm run build

# -------------------------------------------------------------------------
# STAGE 2: PRODUCTION NGINX REVERSE PROXY & STATIC SERVER
# -------------------------------------------------------------------------
FROM nginx:1.25-alpine AS production

# Install curl for container healthcheck
RUN apk add --no-cache curl

# Remove default nginx static assets
RUN rm -rf /usr/share/nginx/html/*

# Copy compiled production bundle from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy custom NGINX reverse-proxy configuration
COPY nginx/nginx.conf /etc/nginx/conf.d/default.conf

# Expose HTTP port
EXPOSE 80

# Health check to ensure NGINX is responding
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
    CMD curl -f http://localhost/ || exit 1

# Start NGINX in foreground
CMD ["nginx", "-g", "daemon off;"]
